# Environment overrides for library-rag.
# Copy to `.env` and adjust. Only secrets and a few switches belong here; the
# rest of the configuration lives in the YAML config file.

# Path to the YAML config file (overrides the built-in default).
# LIBRARY_RAG_CONFIG=/dd2/andrei/books_rag/config.yaml

# Bearer token required before the API is exposed beyond 127.0.0.1.
# LIBRARY_RAG_API_TOKEN=change-me

# Log level for the CLI/server (DEBUG, INFO, WARNING, ERROR).
# LIBRARY_RAG_LOG_LEVEL=INFO

# GPU selection for embedding/answer workers is done via GPU UUIDs in the config
# (gpu_profiles), NOT via CUDA ordinals, because on this host CUDA device ordinals
# do not match nvidia-smi indices. Do not set CUDA_VISIBLE_DEVICES globally here;
# per-worker assignment is handled by the runtime.
