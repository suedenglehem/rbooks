# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
serve.log

# Frontend (web/): dependencies are never committed; the built bundle (web/dist)
# IS committed because the server serves it and the M5 gate wants a self-hosted UI.
web/node_modules/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Reference clone of the LlamaIndex monorepo kept locally for API reference.
# Never part of this project; keep it out of git and out of linters.
llama_index/

# Local configuration and secrets (never commit real paths or tokens)
config.yaml
.env

# Local scratch / data that never belongs in git (PRD §10: durable outputs on SSD)
.resume
state/
archive/
artifacts/
qdrant/
scratch/
models/

# Editor / OS
.DS_Store
.idea/
.vscode/
